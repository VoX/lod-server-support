# .github/line.env — this branch's release-line identity (V-1/P1,
# docs/planning/version-port-isolation-plan.md). The release workflow body is
# branch-invariant: a support line edits ONLY this file (plus the per-line
# build.gradle dependency pins). Comments and blank lines are filtered before
# sourcing into $GITHUB_ENV. Space-separated values expand to newline lists in
# the workflow (the "Expand line lists" step).
#
# LINE_TAG_SUFFIX: '' on main; '+mc26.1' etc. on a support line — the guard
# refuses any tag whose '+...' suffix differs from this value.
# ReleaseWorkflowContractTest cross-pins these values against gradle.properties'
# minecraft_version (which the build itself consumes), so a forward merge that
# clobbers this file back to another line's shape cannot go green.
LINE_TAG_SUFFIX=
LINE_MC_FABRIC=26.2
LINE_MC_PAPER=26.2
LINE_MC_NEOFORGE=26.2
LINE_JAVA_VERSION=25
LINE_MAKE_LATEST=true
LINE_GAME_VERSIONS_FABRIC=26.2
LINE_GAME_VERSIONS_PAPER=26.2
LINE_GAME_VERSIONS_NEOFORGE=26.2
LINE_PAPER_LOADERS=paper purpur folia
LINE_NEOFORGE_NAME=NeoForge (MC 26.2)
# v0.13.1 scope (user decision 2026-08-27): NeoForge SHIPS on this line — the
# VoX/Foxy fork (Voxy-on-NeoForge, Windows natives fixed 2026-08-26) is the
# working client pairing on 26.x, retiring v0.11.0's 1.21.1-only scope. true =
# release.yml builds + attaches + Modrinth-publishes the module and
# release_check requires its families. release_check.py DERIVES its
# SHIP_NEOFORGE from this value (R2-5) — one edit here is the whole flip.
LINE_SHIP_NEOFORGE=true
# Fabric jar manifest mapping namespace (release_check derives): official on the
# 26.x/1.21.11 toolchains; intermediary under loom-remap lines.
LINE_FABRIC_MAPPING_NAMESPACE=official
