# .github/line.env — this branch's release-line identity (V-1/P1,
# docs/planning/version-port-isolation-plan.md). The release workflow body is
# branch-invariant: a support line edits ONLY this file (plus the per-line
# build.gradle dependency pins). Comments and blank lines are filtered before
# sourcing into $GITHUB_ENV. Space-separated values expand to newline lists in
# the workflow (the "Expand line lists" step).
#
# LINE_TAG_SUFFIX: '' on main; '+mc26.1' etc. on a support line — the guard
# refuses any tag whose '+...' suffix differs from this value.
# ReleaseWorkflowContractTest cross-pins these values against gradle.properties'
# minecraft_version (which the build itself consumes), so a forward merge that
# clobbers this file back to another line's shape cannot go green.
LINE_TAG_SUFFIX=+mc26.1
LINE_MC_FABRIC=26.1
LINE_MC_PAPER=26.1.2
LINE_MC_NEOFORGE=26.1.2
LINE_JAVA_VERSION=25
LINE_MAKE_LATEST=false
LINE_GAME_VERSIONS_FABRIC=26.1 26.1.1 26.1.2
LINE_GAME_VERSIONS_PAPER=26.1.2
LINE_GAME_VERSIONS_NEOFORGE=26.1.2
LINE_PAPER_LOADERS=paper purpur folia
LINE_NEOFORGE_NAME=NeoForge (MC 26.1)
# Ship scope (user decision 2026-08-27, since v0.13.1): NeoForge SHIPS on this
# line — the VoX/Foxy fork is the client pairing. Superseded: NeoForge only on the
# 1.21.1 line (the one line with a working client pairing — the community Voxy
# port). false = the module still builds/tests in CI, but release.yml skips its
# build + assets + Modrinth step and release_check does not require its families.
# Flip release_check.py's SHIP_NEOFORGE together with this value —
# ReleaseWorkflowContractTest cross-pins the pair.
LINE_SHIP_NEOFORGE=true
