# .github/line.env — this branch's release-line identity (V-1/P1,
# docs/planning/version-port-isolation-plan.md). The release workflow body is
# branch-invariant: a support line edits ONLY this file (plus the per-line
# build.gradle dependency pins). Comments and blank lines are filtered before
# sourcing into $GITHUB_ENV. Space-separated values expand to newline lists in
# the workflow (the "Expand line lists" step).
#
# LINE_TAG_SUFFIX: '' on main; '+mc26.1' etc. on a support line — the guard
# refuses any tag whose '+...' suffix differs from this value.
# ReleaseWorkflowContractTest cross-pins these values against gradle.properties'
# minecraft_version (which the build itself consumes), so a forward merge that
# clobbers this file back to another line's shape cannot go green.
LINE_TAG_SUFFIX=+mc1.21.10
LINE_MC_FABRIC=1.21.10
LINE_MC_PAPER=1.21.10
LINE_MC_NEOFORGE=1.21.10
LINE_JAVA_VERSION=21
LINE_MAKE_LATEST=false
LINE_GAME_VERSIONS_FABRIC=1.21.10
LINE_GAME_VERSIONS_PAPER=1.21.10
LINE_GAME_VERSIONS_NEOFORGE=1.21.10
LINE_PAPER_LOADERS=paper purpur
LINE_NEOFORGE_NAME=NeoForge (MC 1.21.10, server-side)
# v0.11.0 release scope (user decision 2026-08-15): NeoForge SHIPS only on the
# 1.21.1 line (the one line with a working client pairing — the community Voxy
# port). false = the module still builds/tests in CI, but release.yml skips its
# build + assets + Modrinth step and release_check does not require its families.
# Flip release_check.py's SHIP_NEOFORGE together with this value —
# ReleaseWorkflowContractTest cross-pins the pair.
LINE_SHIP_NEOFORGE=false

# Sponge (sponge-support-plan.md §0.3/§2.1): the SpongeVanilla server plugin. true =
# release.yml builds + attaches + Modrinth-publishes the module and release_check
# requires its families; build.yml builds + tests it on every line regardless. A line
# flips to true only after its live server smoke passes on the frozen candidate. The
# Sponge MC version IS minecraft_version (SpongeToolchainContractTest), and the name is
# "experimental" until the plan's §0.2 exit criterion holds on this line. This line
# predates R2-5: scripts/release_check.py HAND-MIRRORS LINE_SHIP_SPONGE as SHIP_SPONGE
# (flip BOTH together; ReleaseWorkflowContractTest pins the coupling).
# Sponge ships from main (26.3) only since 0.22.0 (decision 0001 on main); this frozen line
# stops shipping it with 0.21.1. 0.21.0 stays published. The module still builds and is tested here.
LINE_SHIP_SPONGE=false
LINE_MC_SPONGE=1.21.10
LINE_GAME_VERSIONS_SPONGE=1.21.10
LINE_SPONGE_NAME=Sponge (MC 1.21.10, experimental)
